# --- core ---
NODE_ENV=development
PORT=4100

# --- database (docker-compose.dev.yml defaults) ---
DATABASE_URL=postgresql://loadless:loadless@localhost:5432/loadless?schema=public

# --- redis (docker-compose.dev.yml defaults) ---
REDIS_URL=redis://localhost:6379

# --- auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Exact browser origin (no trailing slash). In dev this is the Next.js app.
APP_ORIGIN=http://localhost:3100

# --- sockets ---
# Set true only when running multiple API instances (enables Redis adapter).
SOCKET_REDIS_ADAPTER=false

# --- uploads ---
# local (dev) | r2 (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- proxies ---
# 1 = behind Caddy directly; 0 in local dev (Next rewrite proxy is same-host)
TRUSTED_PROXY_HOPS=0
