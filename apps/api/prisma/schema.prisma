generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  VENDOR
  DRIVER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
}

enum Currency {
  LBP
  USD
}

enum OrderStatus {
  PENDING
  DRIVER_ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum ActorType {
  ADMIN
  VENDOR
  DRIVER
  SYSTEM
}

enum FilePurpose {
  VENDOR_LOGO
  DRIVER_FACE
  DRIVER_BIKE
}

enum SettlementStatus {
  SETTLED
  VOIDED
}

enum AdjustmentType {
  FINE
  BONUS
  ADVANCE
  CORRECTION
}

// ---------------------------------------------------------------------------
// Auth identity
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  /// Login identity: DRIVER -> normalizedPhone, ADMIN/VENDOR -> email
  /// (enforced by the user_identity_by_role CHECK).
  email           String?   @unique
  normalizedPhone String?   @unique @map("normalized_phone")
  passwordHash    String    @map("password_hash")
  role            Role
  isActive        Boolean   @default(true) @map("is_active")
  tokenVersion    Int       @default(0) @map("token_version")
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  vendor        Vendor?
  driver        Driver?
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

model Vendor {
  id           String        @id @default(cuid())
  userId       String        @unique @map("user_id")
  user         User          @relation(fields: [userId], references: [id])
  businessName String        @map("business_name")
  logoKey      String?       @map("logo_key")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  orders           Order[]
  createdCustomers Customer[]        @relation("CustomerCreator")
  customerLinks    CustomerVendor[]
  ownedAddresses   CustomerAddress[] @relation("AddressOwner")

  @@map("vendors")
}

model Driver {
  id                    String        @id @default(cuid())
  userId                String        @unique @map("user_id")
  user                  User          @relation(fields: [userId], references: [id])
  fullName              String        @map("full_name")
  contactPhone          String        @map("contact_phone")
  facePhotoKey          String?       @map("face_photo_key")
  bikePhotoKey          String?       @map("bike_photo_key")
  status                AccountStatus @default(ACTIVE)
  dutyStatus            DutyStatus    @default(OFF_DUTY) @map("duty_status")
  commissionOverrideBps Int?          @map("commission_override_bps")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  orders      Order[]
  settlements DriverSettlement[]
  balances    DriverBalance[]

  @@index([dutyStatus, status])
  @@map("drivers")
}

// ---------------------------------------------------------------------------
// Customers — GLOBAL, shared across all vendors
// ---------------------------------------------------------------------------

model Customer {
  id                String   @id @default(cuid())
  normalizedPhone   String   @unique @map("normalized_phone")
  name              String
  createdByVendorId String?  @map("created_by_vendor_id")
  createdByVendor   Vendor?  @relation("CustomerCreator", fields: [createdByVendorId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  addresses     CustomerAddress[]
  orders        Order[]
  changeHistory CustomerChangeHistory[]
  vendorLinks   CustomerVendor[]

  @@index([createdByVendorId])
  /// The admin directory orders by createdAt desc; without this it scans every
  /// customer on every page.
  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

/// The vendor<->customer relationship. A row exists once a vendor CREATES a
/// customer or places an order for one; the same customer can be linked to
/// many vendors. This is what makes "my customers" a bounded list instead of
/// a global directory, and what carries each vendor's PRIVATE overlay.
///
/// Maintained by Postgres triggers (see the customer_vendor_relationship
/// migration), never by app code: a link row is an invariant of "an order
/// exists", so it must be written inside the order's own transaction whether
/// the insert came from the service, a script, or a test fixture.
model CustomerVendor {
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendorId   String   @map("vendor_id")
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// This vendor's PRIVATE name for the customer. NULL = follow customers.name.
  /// No other vendor and no driver ever sees it.
  displayName String? @map("display_name")

  /// Denormalized by the trigger so the list sorts and pages straight off an
  /// index instead of aggregating orders per row.
  ordersCount    Int       @default(0) @map("orders_count")
  lastOrderAt    DateTime? @map("last_order_at")
  /// Sort key for "my customers" — never NULL, so the index scan needs no Sort.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([customerId, vendorId])
  @@index([vendorId, lastActivityAt(sort: Desc), customerId(sort: Desc)], map: "customer_vendors_vendor_activity_idx")
  @@map("customer_vendors")
}

model CustomerAddress {
  id                String       @id @default(cuid())
  customerId        String       @map("customer_id")
  customer          Customer     @relation(fields: [customerId], references: [id])
  label             AddressLabel @default(OTHER)
  /// Optional: a shared Google Maps link alone is a complete location.
  addressText       String?      @map("address_text")
  /// Google Maps link the customer shared (the way locations travel in Lebanon)
  mapsUrl           String?      @map("maps_url")
  lat               Float?
  lng               Float?
  isArchived        Boolean      @default(false) @map("is_archived")
  /// OWNERSHIP, not just attribution: only this vendor (or an admin) may edit
  /// or archive the row. NULL = platform-owned (admin-editable only).
  createdByVendorId String?      @map("created_by_vendor_id")
  createdByVendor   Vendor?      @relation("AddressOwner", fields: [createdByVendorId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([customerId, isArchived])
  @@index([createdByVendorId])
  @@map("customer_addresses")
}

model CustomerChangeHistory {
  id              String    @id @default(cuid())
  customerId      String    @map("customer_id")
  customer        Customer  @relation(fields: [customerId], references: [id])
  changedByUserId String    @map("changed_by_user_id")
  actorType       ActorType @map("actor_type")
  changes         Json
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("customer_change_history")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique @map("order_number")
  vendorId    String      @map("vendor_id")
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  customerId  String      @map("customer_id")
  customer    Customer    @relation(fields: [customerId], references: [id])
  driverId    String?     @map("driver_id")
  driver      Driver?     @relation(fields: [driverId], references: [id])
  status      OrderStatus @default(PENDING)

  // Delivery snapshot — frozen copy; never mutates the customer profile.
  // Text OR maps link is enough — customers often just share a pin.
  deliveryAddressText String? @map("delivery_address_text")
  /// Google Maps link for THIS delivery — what the driver actually navigates by
  deliveryMapsUrl     String? @map("delivery_maps_url")
  deliveryLat         Float?  @map("delivery_lat")
  deliveryLng         Float?  @map("delivery_lng")

  deliveryInstructions String?    @map("delivery_instructions")
  cancellationReason   String?    @map("cancellation_reason")
  cancelledByType      ActorType? @map("cancelled_by_type")
  cancelledByUserId    String?    @map("cancelled_by_user_id")
  failureReason        String?    @map("failure_reason")

  // Financial snapshot — charge/currency at creation; commission fields
  // computed atomically at driver acceptance (per-driver rate), cleared on release
  deliveryCharge           BigInt   @map("delivery_charge")
  currency                 Currency @default(LBP)
  commissionBps            Int?     @map("commission_bps")
  platformCommissionAmount BigInt?  @map("platform_commission_amount")
  driverEarnings           BigInt?  @map("driver_earnings")

  /// Set when this order's commission has been collected from the driver in
  /// cash. Stamping the order — rather than re-deriving a past settlement from
  /// a date range — is what makes double-collection structurally impossible and
  /// keeps a settlement reconcilable order by order, forever.
  settlementId String?           @map("settlement_id")
  settlement   DriverSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  assignedAt  DateTime? @map("assigned_at")
  pickedUpAt  DateTime? @map("picked_up_at")
  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statusHistory OrderStatusHistory[]

  @@index([vendorId, status, createdAt])
  // The vendor's home screen is the UNFILTERED list. With status in the middle
  // of the index above, an unfiltered read cannot get createdAt ordering from
  // it — it read every one of the vendor's orders and top-N sorted them (33ms
  // at 16k orders). This serves the same page as a pure index scan.
  @@index([vendorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([driverId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt])
  // Customer 360: the vendor-scoped slice of one customer's history — the
  // hottest read in the vendor UI (fires on every phone lookup mid-call).
  @@index([customerId, vendorId, createdAt])
  // Admin's order list and every date-range analytics read. Without it the
  // platform's main operational screen sequential-scans the whole table.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Listing the orders one settlement covered. Non-partial, so it must be
  // declared here or Prisma drops it on the next migrate.
  @@index([settlementId])
  // Partial index for the PENDING feed lives in raw SQL (see constraints migration)
  // As does orders_unsettled_by_driver_idx — the settlement sweep's hot path.
  @@map("orders")
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id])
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorType   ActorType    @map("actor_type")
  actorUserId String?      @map("actor_user_id")
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Driver settlements — the end-of-day cash handover
//
// The driver collects the delivery fee at the door, keeps his earnings and owes
// the platform its commission. These tables are the record of that cash
// actually changing hands. They are APPEND-ONLY: a settlement is never edited
// or deleted, only voided, because they describe money that physically moved.
// ---------------------------------------------------------------------------

/// One recorded cash handover between a driver and the platform.
model DriverSettlement {
  id               String @id @default(cuid())
  settlementNumber String @unique @map("settlement_number")

  driverId String @map("driver_id")
  driver   Driver @relation(fields: [driverId], references: [id])

  /// Sweep window (periodStart, periodEnd]. periodStart is the previous
  /// non-voided settlement's periodEnd — null for a driver's first ever.
  /// Bounding by INSTANTS rather than calendar days is what lets a driver skip
  /// a day, or turn up at 2am, without anything falling through a gap.
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime  @map("period_end")

  status SettlementStatus @default(SETTLED)

  settledAt         DateTime @default(now()) @map("settled_at")
  collectedByUserId String   @map("collected_by_user_id")
  note              String?

  voidedAt       DateTime? @map("voided_at")
  voidedByUserId String?   @map("voided_by_user_id")
  voidReason     String?   @map("void_reason")

  lines       DriverSettlementLine[]
  adjustments SettlementAdjustment[]
  orders      Order[]

  @@index([driverId, settledAt(sort: Desc)])
  @@index([settledAt(sort: Desc), id(sort: Desc)])
  @@map("driver_settlements")
}

/// One currency's arithmetic within a handover. Two rows if the driver ran both
/// LBP and USD orders. The currencies are NEVER merged into a single total.
model DriverSettlementLine {
  id           String           @id @default(cuid())
  settlementId String           @map("settlement_id")
  settlement   DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  currency     Currency

  orderCount       Int    @map("order_count")
  /// Sum of delivery charges, for context on the receipt — never itself billed.
  grossCharge      BigInt @map("gross_charge")
  commissionDue    BigInt @map("commission_due")
  /// Signed: fines add, bonuses subtract.
  adjustmentsTotal BigInt @map("adjustments_total")
  /// Signed. The previous settlement's shortfall, carried into this one.
  broughtForward   BigInt @map("brought_forward")
  totalDue         BigInt @map("total_due")
  amountCollected  BigInt @map("amount_collected")
  /// Signed. Positive = still owed, negative = the driver is in credit.
  carriedForward   BigInt @map("carried_forward")

  @@unique([settlementId, currency])
  @@map("driver_settlement_lines")
}

/// Non-order money on a settlement: a fine, a bonus, a fuel advance, a fix.
/// Exists so an admin never has to misreport what was collected to make the
/// numbers come out right.
model SettlementAdjustment {
  id           String           @id @default(cuid())
  settlementId String           @map("settlement_id")
  settlement   DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  currency     Currency
  type         AdjustmentType
  /// Signed minor units in "what the driver owes" terms: positive increases the
  /// debt, negative reduces it. The sign is DB-checked against the type.
  amount       BigInt
  reason       String

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([settlementId])
  @@map("settlement_adjustments")
}

/// A driver's running balance per currency.
///
/// Derivable from the settlement chain, but materialised so the admin's
/// end-of-day worklist ("who owes what right now", across every driver) is one
/// indexed scan instead of a correlated subquery per driver. An integration
/// test reconciles it against the chain.
model DriverBalance {
  driverId    String   @map("driver_id")
  driver      Driver   @relation(fields: [driverId], references: [id])
  currency    Currency
  /// Signed: >0 the driver owes the platform, <0 the platform owes him.
  outstanding BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([driverId, currency])
  @@map("driver_balances")
}

model PlatformSetting {
  id                   String   @id @default("singleton")
  defaultCommissionBps Int      @default(3000) @map("default_commission_bps")
  settings             Json     @default("{}")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String    @map("actor_user_id")
  actorType   ActorType @map("actor_type")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model FileObject {
  id          String      @id @default(cuid())
  key         String      @unique
  purpose     FilePurpose
  ownerUserId String      @map("owner_user_id")
  contentType String      @map("content_type")
  sizeBytes   Int         @map("size_bytes")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("file_objects")
}
